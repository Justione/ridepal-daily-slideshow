{% macro ruler(color='#234A38', size=30) -%}
<svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect x="2" y="8" width="20" height="8" rx="1.5" stroke="{{color}}" stroke-width="1.8"/>
<path d="M6 8V11M10 8V11M14 8V11M18 8V11" stroke="{{color}}" stroke-width="1.8" stroke-linecap="round"/>
</svg>
{%- endmacro %}

